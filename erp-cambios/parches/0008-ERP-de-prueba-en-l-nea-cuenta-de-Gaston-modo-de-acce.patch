+
+test("modo basic (DEV en línea): solo con la contraseña; sin contraseña configurada no entra nadie", async () => {
+  const conClave = (user: string, pass: string) => new Request("https://erp-dev.example/", { headers: { Authorization: "Basic " + btoa(`${user}:${pass}`) } });
+  const config = { WMS_ACCESS_MODE: "basic", ACCESO_DEV: "clave-de-prueba-123" };
+  assert.equal(await authorizeAccess(conClave("x", "clave-de-prueba-123"), config), true);
+  assert.equal(await authorizeAccess(conClave("x", "otra-clave-12345678"), config), false);
+  assert.equal(await authorizeAccess(new Request("https://erp-dev.example/"), config), false);
+  assert.equal(await authorizeAccess(conClave("x", ""), { WMS_ACCESS_MODE: "basic" }), false);
+  assert.equal(await authorizeAccess(conClave("x", "clave-de-prueba-123"), { WMS_ACCESS_MODE: "production" }), false, "otros modos no aceptan la contraseña");
+});
diff --git a/worker/access.ts b/worker/access.ts
index 8e982ce..5bdf03b 100644
--- a/worker/access.ts
+++ b/worker/access.ts
@@ -5,13 +5,30 @@ export type AccessConfiguration = {
   WMS_ACCESS_TEAM_DOMAIN?: string;
   WMS_ACCESS_AUD?: string;
   WMS_ACCESS_ALLOWED_EMAILS?: string;
+  // Solo DEV en línea: contraseña única delante de todo (modo "basic").
+  ACCESO_DEV?: string;
 };
 
+// Modo "basic" (solo DEV en línea): el navegador pide una contraseña antes de mostrar el ERP.
+// Sin contraseña configurada no entra nadie. El login del ERP (usuario + PIN) sigue igual detrás.
+export function authorizeBasic(request: Request, config: AccessConfiguration) {
+  const clave = config.ACCESO_DEV || "";
+  const auth = request.headers.get("Authorization") || "";
+  if (clave.length < 8 || !auth.startsWith("Basic ")) return false;
+  let dada = "";
+  try { dada = new TextDecoder().decode(Uint8Array.from(atob(auth.slice(6)), (c) => c.charCodeAt(0))).split(":").slice(1).join(":"); } catch { return false; }
+  if (dada.length !== clave.length) return false;
+  let diff = 0;
+  for (let i = 0; i < clave.length; i++) diff |= clave.charCodeAt(i) ^ dada.charCodeAt(i);
+  return diff === 0;
+}
+
 // Only public verification keys are cached, never tokens or user identities.
 const keySets = new Map<string, JWTVerifyGetKey>();
 
 export async function authorizeAccess(request: Request, config: AccessConfiguration, verificationKey?: JWTVerifyGetKey): Promise<boolean> {
   if (config.WMS_ACCESS_MODE === "optional") return true;
+  if (config.WMS_ACCESS_MODE === "basic") return authorizeBasic(request, config);
   if (config.WMS_ACCESS_MODE !== "required") return false;
   const team = (config.WMS_ACCESS_TEAM_DOMAIN || "").trim();
   const audience = (config.WMS_ACCESS_AUD || "").trim();
