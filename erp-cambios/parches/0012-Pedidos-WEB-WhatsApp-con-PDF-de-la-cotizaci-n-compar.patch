+  // Pedidos WEB: PDF de la cotización + mensaje. Si el navegador deja compartir archivos (celular, Safari),
+  // sale por la hoja de compartir con el PDF adjunto; si no, se descarga el PDF y se abre WhatsApp con el texto.
+  async function sendWebOrderWhatsApp(order: Order, message: { phone: string; text: string; link: string }) {
+    if (workflowSavingRef.current) return;
+    workflowSavingRef.current = `${order.id}:whatsapp`;
+    setWorkflowSavingKey(workflowSavingRef.current);
+    // La ventana se abre en el clic (si no, el navegador la bloquea) y después se le pone la dirección.
+    const canShareFiles = typeof navigator.canShare === "function" && navigator.canShare({ files: [new File([""], "x.pdf", { type: "application/pdf" })] });
+    const whatsappWindow = canShareFiles ? null : window.open("", "_blank");
+    try {
+      const response = await fetch(`/api/warehouse?scope=quotation&orderId=${encodeURIComponent(order.id)}`, { cache: "no-store" });
+      const data = await response.json() as { sale?: SaleRecord; error?: string };
+      if (!response.ok || !data.sale) throw new Error(data.error || "No se pudo cargar la cotización.");
+      const quotation = { orderId: order.id, issuedAt: data.sale.createdAt || order.quoteSentAt || new Date().toISOString(), sale: data.sale };
+      const doc = await buildRemittancePdf({ orderId: quotation.orderId, series: "COT", remittanceNumber: Number(quotation.orderId.replace(/\D/g, "")) || 1, issuedAt: quotation.issuedAt, sale: quotation.sale }, "COTIZACIÓN");
+      const fileName = `Cotizacion-${visibleOrderId(order)}.pdf`;
+      const file = new File([doc.output("blob")], fileName, { type: "application/pdf" });
+      if (canShareFiles) await navigator.share({ files: [file], text: message.text });
+      else {
+        await doc.save(fileName, { returnPromise: true });
+        if (whatsappWindow) whatsappWindow.location.href = message.link; else window.open(message.link, "_blank");
+        showSystemToast("success", "Cotización lista", `PDF descargado (${fileName}). Adjuntalo en el chat de WhatsApp que se abrió.`);
+      }
+      if (["draft", "quote_sent"].includes(order.commercialStatus || "")) await saveWarehouse("mark-quotation-downloaded", { orderId: order.id, total: quotation.sale.total, items: quotation.sale.items, operator: user?.name || "" });
+    } catch (error) {
+      whatsappWindow?.close();
+      if (!(error instanceof DOMException && error.name === "AbortError")) showSystemToast("error", "WhatsApp", error instanceof Error ? error.message : "No se pudo preparar el WhatsApp.");
+    } finally {
+      workflowSavingRef.current = "";
+      setWorkflowSavingKey("");
+    }
+  }
+
   async function reopenQuotation(order: Order, download = false, viaQr = false) {
     if (workflowSavingRef.current) return;
     workflowSavingRef.current = `${order.id}:pdf`;
@@ -8472,6 +8505,7 @@ if (has("productBarcodeAliases")) setProductBarcodeAliases(current => catalogPar
