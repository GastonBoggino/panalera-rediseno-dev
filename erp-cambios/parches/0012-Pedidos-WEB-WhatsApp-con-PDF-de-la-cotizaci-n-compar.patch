+// DEV: alias falso. En producción va el alias real del local.
+const TRANSFER_ALIAS = "test123";
+
+// El total según cómo eligió pagar: transferencia (con alias), efectivo, o los dos si no indicó.
+function totalText(order: WebOrderRow) {
+  if (!order.totalAmount) return "";
+  const pago = (order.paymentMethod || "").toLowerCase();
+  if (pago.includes("transfer")) return `\nTotal con transferencia: ${money(order.totalAmount * 1.05)}.\nAlias: ${TRANSFER_ALIAS}`;
+  if (pago.includes("efectivo")) return `\nTotal en efectivo: ${money(order.totalAmount)}.`;
+  return `\nTotal en efectivo: ${money(order.totalAmount)} · con transferencia: ${money(order.totalAmount * 1.05)}.`;
+}
+
 // "Tenemos todo en stock" solo si el stock está contado y alcanza; sin conteo, mensaje neutro.
-function whatsappLink(order: WebOrderRow, missing: string[], allCounted: boolean) {
+export function whatsappMessage(order: WebOrderRow, missing: string[], allCounted: boolean) {
   const digits = (order.customerPhone || "").replace(/\D/g, "");
-  if (digits.length < 10) return "";
+  if (digits.length < 10) return null;
   const phone = digits.startsWith("54") ? digits : `54${digits}`;
   const name = order.customer.split(/\s+/)[0] || "";
-  const total = order.totalAmount ? `\nTotal en efectivo: ${money(order.totalAmount)} · con transferencia: ${money(order.totalAmount * 1.05)}.` : "";
+  const total = totalText(order);
   const text = missing.length
     ? `Hola ${name}! Recibimos tu pedido web #${order.visibleId}. Revisamos el stock y nos faltan:\n${missing.map((m) => `• ${m}`).join("\n")}\n¿Te lo reemplazamos por otro producto o lo quitamos?`
     : allCounted
       ? `Hola ${name}! Recibimos tu pedido web #${order.visibleId} y tenemos todo en stock.${total}\n¿Lo confirmamos?`
       : `Hola ${name}! Recibimos tu pedido web #${order.visibleId}.${total}\n¿Lo confirmamos?`;
-  return `https://wa.me/${phone}?text=${encodeURIComponent(text)}`;
+  return { phone, text, link: `https://wa.me/${phone}?text=${encodeURIComponent(text)}` };
 }
 
