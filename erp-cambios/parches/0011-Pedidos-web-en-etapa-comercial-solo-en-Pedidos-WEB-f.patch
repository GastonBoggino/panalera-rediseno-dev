   const commercialFilteredOrders = useMemo(() => {
     const query = orderQuery.trim().toLowerCase();
-    return orders.filter((order) => ["draft", "quote_sent"].includes(order.commercialStatus || "confirmed") && (!hideSentQuotations || order.commercialStatus !== "quote_sent" || !(order.quoteLastSentAt || order.quoteSentAt)) && (!hideOldQuotations || !(Date.now() - operationalDate(order.quoteLastSentAt || order.quoteSentAt || order.date).getTime() > 5 * 86400000)) && !incidentOrderIds.has(order.id) && !pendingSubstitutionsByOrder[order.id]?.length && !stockSkusByOrder[order.id]?.length && !localIncidentCases.some(item=>item.orderId===order.id) && (
+    // Los pedidos web en etapa comercial se atienden solo en "Pedidos WEB"; al confirmarse pasan al depósito.
+    return orders.filter((order) => ["draft", "quote_sent"].includes(order.commercialStatus || "confirmed") && !isWebOrder(order.source) && (!hideSentQuotations || order.commercialStatus !== "quote_sent" || !(order.quoteLastSentAt || order.quoteSentAt)) && (!hideOldQuotations || !(Date.now() - operationalDate(order.quoteLastSentAt || order.quoteSentAt || order.date).getTime() > 5 * 86400000)) && !incidentOrderIds.has(order.id) && !pendingSubstitutionsByOrder[order.id]?.length && !stockSkusByOrder[order.id]?.length && !localIncidentCases.some(item=>item.orderId===order.id) && (
       !query || visibleOrderId(order).toLowerCase().includes(query) || order.customer.toLowerCase().includes(query) || (order.customerPhone || "").includes(query)
     ));
   }, [orders, orderQuery, incidentOrderIds, pendingSubstitutionsByOrder, stockSkusByOrder, localIncidentCases, hideOldQuotations, hideSentQuotations]);
