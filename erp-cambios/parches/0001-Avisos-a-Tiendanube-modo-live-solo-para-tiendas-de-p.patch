diff --git a/app/api/tiendanube/statusPush.ts b/app/api/tiendanube/statusPush.ts
new file mode 100644
index 0000000..78693f3
--- /dev/null
+++ b/app/api/tiendanube/statusPush.ts
@@ -0,0 +1,214 @@
+// Aviso del estado de los pedidos web a Tiendanube.
+// Los triggers encolan cada cambio de estado en la misma transacción que lo produce.
+// TIENDANUBE_STATUS_PUSH:
+//   (vacío)    apagado: la cola se llena y no se procesa.
+//   simulate   arma la solicitud que se enviaría y la registra, sin red.
+//   live       la envía de verdad, SOLO si la tienda está en TIENDANUBE_WRITE_STORES.
+//              La tienda real (6357775) está bloqueada en el código, figure o no en la lista.
+// Ver docs/DISENO-ERP-A-TIENDANUBE-20261022.md.
+
+export type StatusPushTarget =
+  | 'quote_sent_note' | 'confirmed_note'
+  | 'in_preparation' | 'ready_for_pickup' | 'packed' | 'dispatched' | 'delivered'
+  | 'cancelled';
+
+export type StatusPushEnv = {
+  DB: D1Database; TIENDANUBE_STATUS_PUSH?: string; TIENDANUBE_WRITE_STORES?: string;
+  TIENDANUBE_STORE_ID?: string; TIENDANUBE_ACCESS_TOKEN?: string; TIENDANUBE_USER_AGENT?: string;
+};
+export const TIENDA_REAL = '6357775';
+const MAX_INTENTOS = 5;
+type Row = { order_id: string; target: StatusPushTarget; platform_id: string; created_at: string; attempts?: number };
+type Order = { order_id: string; platform_id: string; source: string; mode: string; commercial_status: string; delivery_status: string; updated_by: string };
+
+const webOrder = `lower(e.source) LIKE '%tiendanube%'`;
+const nowSql = `strftime('%Y-%m-%dT%H:%M:%fZ','now')`;
+const enqueue = (id: string, target: StatusPushTarget) => `INSERT OR IGNORE INTO tiendanube_status_push(order_id,target,platform_id,status,created_at,updated_at)
+ SELECT e.order_id,'${target}',e.platform_id,'pending',${nowSql},${nowSql} FROM external_orders e WHERE e.order_id=${id} AND ${webOrder}`;
+
+// Etapas de preparación/entrega: Tiendanube no acepta volver atrás.
+export const fulfillmentRank: Partial<Record<StatusPushTarget, number>> = {in_preparation: 1, ready_for_pickup: 2, packed: 2, dispatched: 3, delivered: 4};
+
+export const tiendanubeStatusPushSchema = [
+  `CREATE TABLE IF NOT EXISTS tiendanube_status_push (
+ order_id TEXT NOT NULL, target TEXT NOT NULL, platform_id TEXT NOT NULL DEFAULT '',
+ status TEXT NOT NULL DEFAULT 'pending' CHECK(status IN ('pending','simulated','skipped','sent','failed')), attempts INTEGER NOT NULL DEFAULT 0,
+ request TEXT NOT NULL DEFAULT '', detail TEXT NOT NULL DEFAULT '',
+ created_at TEXT NOT NULL, updated_at TEXT NOT NULL, PRIMARY KEY(order_id,target))`,
+  `CREATE INDEX IF NOT EXISTS tiendanube_status_push_due ON tiendanube_status_push(status,created_at)`,
+  // Cotización enviada al cliente (la importación web deja quote_sent_at vacío).
+  `CREATE TRIGGER IF NOT EXISTS tn_push_quote_sent AFTER UPDATE OF quote_sent_at ON order_workflow
+ WHEN COALESCE(OLD.quote_sent_at,'')='' AND COALESCE(NEW.quote_sent_at,'')<>'' BEGIN ${enqueue('NEW.order_id', 'quote_sent_note')}; END`,
+  `CREATE TRIGGER IF NOT EXISTS tn_push_confirmed AFTER UPDATE OF commercial_status ON order_workflow
+ WHEN NEW.commercial_status='confirmed' AND OLD.commercial_status<>NEW.commercial_status BEGIN ${enqueue('NEW.order_id', 'confirmed_note')}; END`,
+  // Una cancelación que vino de la web no se reenvía a Tiendanube.
+  `CREATE TRIGGER IF NOT EXISTS tn_push_cancelled AFTER UPDATE OF commercial_status ON order_workflow
+ WHEN NEW.commercial_status IN ('cancelled','rejected') AND OLD.commercial_status NOT IN ('cancelled','rejected') AND COALESCE(NEW.updated_by,'')<>'Tiendanube'
+ BEGIN ${enqueue('NEW.order_id', 'cancelled')}; END`,
+  `CREATE TRIGGER IF NOT EXISTS tn_push_session_insert AFTER INSERT ON order_sessions
+ WHEN NEW.status='in_progress' BEGIN ${enqueue('NEW.order_id', 'in_preparation')}; END`,
+  `CREATE TRIGGER IF NOT EXISTS tn_push_session_update AFTER UPDATE OF status ON order_sessions
+ WHEN NEW.status='in_progress' AND OLD.status<>NEW.status BEGIN ${enqueue('NEW.order_id', 'in_preparation')}; END`,
+  ...([['ready_pickup', 'ready_for_pickup'], ['ready_dispatch', 'packed'], ['in_transit', 'dispatched'], ['delivered', 'delivered']] as const).map(([status, target]) =>
+    `CREATE TRIGGER IF NOT EXISTS tn_push_delivery_${status} AFTER UPDATE OF delivery_status ON order_workflow
+ WHEN NEW.delivery_status='${status}' AND OLD.delivery_status<>NEW.delivery_status BEGIN ${enqueue('NEW.order_id', target)}; END`),
+  `CREATE TRIGGER IF NOT EXISTS tn_push_delivery_record AFTER INSERT ON deliveries BEGIN ${enqueue('NEW.order_id', 'delivered')}; END`,
+];
+
+export async function ensureTiendanubeStatusPush(db: D1Database) {
+  await db.batch(tiendanubeStatusPushSchema.map(sql => db.prepare(sql)));
+}
+
+const date = (iso: string) => new Date(iso).toLocaleString('es-AR', {timeZone: 'America/Argentina/Buenos_Aires', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit'});
+
+// Solicitud que se enviaría a la API de Tiendanube (v1, /{store_id} se agrega al enviar).
+export function statusPushRequest(row: Row, order: Order) {
+  const id = encodeURIComponent(row.platform_id);
+  const fo = `/orders/${id}/fulfillment-orders/{fulfillment_order_id}`;
+  const note = (text: string) => ({method: 'PUT', path: `/orders/${id}`, body: {owner_note: `ERP · ${text} · ${date(row.created_at)}`},
+    scope: 'write_orders', customer: 'No lo ve: es una nota interna. El aviso al cliente sigue por WhatsApp.'});
+  const step = (status: string, customer: string) => ({method: 'PATCH', path: fo, body: {status}, scope: 'write_fulfillment_orders', customer});
+  switch (row.target) {
+    case 'quote_sent_note': return note('Cotización enviada');
+    case 'confirmed_note': return note('Confirmado por el cliente');
+    case 'in_preparation': return step('IN_PREPARATION', '«En preparación»');
+    case 'ready_for_pickup': return step('READY_FOR_PICKUP', '«Listo para retirar»');
+    case 'packed': return step('PACKED', '«Empaquetado»');
+    case 'dispatched': return step('DISPATCHED', '«Enviado»');
+    case 'delivered': return {method: 'POST', path: `${fo}/tracking-events`, body: {status: 'delivered'}, then: {method: 'POST', path: `/orders/${id}/close`},
+      scope: 'write_fulfillment_orders, write_orders', customer: '«Entregado»'};
+    case 'cancelled': return {method: 'POST', path: `/orders/${id}/cancel`,
+      body: {reason: order.commercial_status === 'rejected' ? 'customer' : 'inventory', email: true, restock: false},
+      scope: 'write_orders', customer: '«Cancelado» y e-mail de Tiendanube'};
+  }
+}
+
+type Fetch = typeof fetch;
+class EnvioError extends Error {
+  status: number;
+  constructor(status: number, message: string) { super(message); this.status = status; }
+}
+
+// Envío real a la API. Solo se construye para una tienda permitida que no sea la real.
+export function liveSender(env: StatusPushEnv, fetchImpl: Fetch = (input, init) => fetch(input, init)) {
+  const store = String(env.TIENDANUBE_STORE_ID || '').trim();
+  const permitidas = String(env.TIENDANUBE_WRITE_STORES || '').split(',').map((s) => s.trim()).filter(Boolean);
+  if (!store || store === TIENDA_REAL || permitidas.includes(TIENDA_REAL) || !permitidas.includes(store) || !env.TIENDANUBE_ACCESS_TOKEN) {
+    throw new Error('Envío real bloqueado: la tienda no está en la lista de tiendas de prueba permitidas.');
+  }
+  const api = async (method: string, path: string, body?: unknown) => {
+    const response = await fetchImpl(`https://api.tiendanube.com/v1/${store}${path}`, {
+      method,
+      headers: { Authentication: `bearer ${env.TIENDANUBE_ACCESS_TOKEN}`, 'User-Agent': env.TIENDANUBE_USER_AGENT || 'PanaleraMayoristaRosario', 'Content-Type': 'application/json' },
+      body: body === undefined ? undefined : JSON.stringify(body),
+    });
+    const text = await response.text();
+    if (!response.ok) throw new EnvioError(response.status, `${method} ${path.split('?')[0].replace(/\/\d{5,}/g, '/{id}')} → ${response.status}: ${text.slice(0, 180)}`);
+    return text ? JSON.parse(text) : null;
+  };
+  const fulfillment = async (id: string) => {
+    const lista = await api('GET', `/orders/${id}/fulfillment-orders`);
+    const fo = Array.isArray(lista) ? lista[0] : null;
+    if (!fo?.id) throw new EnvioError(422, 'El pedido no tiene orden de preparación en Tiendanube.');
+    return fo as { id: string; status?: string };
+  };
+  return async (row: Row, request: ReturnType<typeof statusPushRequest>) => {
+    const id = encodeURIComponent(row.platform_id);
+    switch (row.target) {
+      case 'quote_sent_note': case 'confirmed_note': {
+        // La nota se agrega a la que ya tenga el pedido: no pisa lo que escriba el local.
+        const linea = String((request.body as {owner_note: string}).owner_note);
+        const actual = String((await api('GET', `/orders/${id}?fields=owner_note`))?.owner_note || '');
+        const clave = linea.split(' · ').slice(0, 2).join(' · ');
+        if (actual.includes(clave)) return 'La nota ya estaba en Tiendanube.';
+        await api('PUT', `/orders/${id}`, { owner_note: actual ? `${actual}\n${linea}` : linea });
+        return 'Nota interna agregada.';
+      }
+      case 'delivered': {
+        const fo = await fulfillment(id);
+        // Envío: evento "delivered" después de DISPATCHED. Retiro: no hay despacho, se marca DELIVERED.
+        if (String(fo.status).toUpperCase() === 'DISPATCHED') await api('POST', `/orders/${id}/fulfillment-orders/${fo.id}/tracking-events`, { status: 'delivered', happened_at: new Date().toISOString() });
+        else await api('PATCH', `/orders/${id}/fulfillment-orders/${fo.id}`, { status: 'DELIVERED' });
+        await api('POST', `/orders/${id}/close`, {});
+        return 'Entregado y pedido cerrado en Tiendanube.';
+      }
+      case 'cancelled':
+        await api('POST', `/orders/${id}/cancel`, request.body);
+        return 'Pedido cancelado en Tiendanube.';
+      default: {
+        const fo = await fulfillment(id);
+        const status = String((request.body as {status: string}).status);
+        await api('PATCH', `/orders/${id}/fulfillment-orders/${fo.id}`, { status });
+        return `Preparación: ${status}.`;
+      }
+    }
+  };
+}
+
+// Procesa la cola. Solo actúa en modo "simulate" o "live"; con cualquier otro valor no hace nada.
+export async function flushTiendanubeStatusPush(env: StatusPushEnv, now = new Date(), limit = 20, fetchImpl?: Fetch) {
+  const summary = {simulated: 0, skipped: 0, sent: 0, failed: 0, mode: env.TIENDANUBE_STATUS_PUSH || 'off'};
+  if (env.TIENDANUBE_STATUS_PUSH !== 'simulate' && env.TIENDANUBE_STATUS_PUSH !== 'live') return summary;
+  let enviar: ReturnType<typeof liveSender> | null = null;
+  if (env.TIENDANUBE_STATUS_PUSH === 'live') {
+    try { enviar = liveSender(env, fetchImpl); } catch { return {...summary, mode: 'live-bloqueado'}; }
+  }
+  await ensureTiendanubeStatusPush(env.DB);
+  const due = await env.DB.prepare(`SELECT order_id,target,platform_id,created_at,attempts FROM tiendanube_status_push
+ WHERE status='pending' ORDER BY created_at,rowid LIMIT ?`).bind(limit).all<Row>();
+  const instant = now.toISOString();
+  for (const row of due.results) {
+    const order = await env.DB.prepare(`SELECT e.order_id,e.platform_id,e.source,e.mode,w.commercial_status,w.delivery_status,w.updated_by
+ FROM external_orders e JOIN order_workflow w ON w.order_id=e.order_id WHERE e.order_id=?`).bind(row.order_id).first<Order>();
+    const rank = fulfillmentRank[row.target];
+    let skip = '';
+    if (!order) skip = 'El pedido ya no existe en el ERP.';
+    else if (!row.platform_id) skip = 'El pedido no tiene número de Tiendanube.';
+    else if (rank) {
+      const done = await env.DB.prepare(`SELECT target FROM tiendanube_status_push WHERE order_id=? AND status IN ('simulated','sent')`).bind(row.order_id).all<{target: StatusPushTarget}>();
+      const highest = Math.max(0, ...done.results.map(item => fulfillmentRank[item.target] || 0));
+      if (highest >= rank) skip = 'Tiendanube no acepta volver a una etapa anterior o repetida.';
+      else if (done.results.some(item => item.target === 'cancelled')) skip = 'El pedido ya se canceló en Tiendanube.';
+    }
+    if (skip) {
+      await env.DB.prepare(`UPDATE tiendanube_status_push SET status='skipped',detail=?,updated_at=? WHERE order_id=? AND target=? AND status='pending'`)
+        .bind(skip, instant, row.order_id, row.target).run();
+      summary.skipped++;
+      continue;
+    }
+    const request = statusPushRequest(row, order!);
+    if (!enviar) {
+      await env.DB.prepare(`UPDATE tiendanube_status_push SET status='simulated',request=?,detail=?,updated_at=? WHERE order_id=? AND target=? AND status='pending'`)
+        .bind(JSON.stringify(request), `Simulado (no se envió). Cliente: ${request.customer}`, instant, row.order_id, row.target).run();
+      summary.simulated++;
+      continue;
+    }
+    try {
+      const detalle = await enviar(row, request);
+      await env.DB.prepare(`UPDATE tiendanube_status_push SET status='sent',request=?,detail=?,attempts=attempts+1,updated_at=? WHERE order_id=? AND target=? AND status='pending'`)
+        .bind(JSON.stringify(request), `${detalle} Cliente: ${request.customer}`, instant, row.order_id, row.target).run();
+      summary.sent++;
+    } catch (error) {
+      const codigo = error instanceof EnvioError ? error.status : 0;
+      // Conexión, límite de pedidos (429) o error de Tiendanube (5xx): se reintenta en el próximo ciclo.
+      const reintentar = (codigo === 0 || codigo === 429 || codigo >= 500) && Number(row.attempts || 0) + 1 < MAX_INTENTOS;
+      const mensaje = error instanceof Error ? error.message : 'Error desconocido';
+      await env.DB.prepare(`UPDATE tiendanube_status_push SET status=?,request=?,detail=?,attempts=attempts+1,updated_at=? WHERE order_id=? AND target=? AND status='pending'`)
+        .bind(reintentar ? 'pending' : 'failed', JSON.stringify(request), reintentar ? `Reintentando: ${mensaje}` : `No se pudo enviar: ${mensaje}`, instant, row.order_id, row.target).run();
+      if (!reintentar) summary.failed++;
+    }
+  }
+  return summary;
+}
+
+export async function statusPushReport(db: D1Database, limit = 50) {
+  await ensureTiendanubeStatusPush(db);
+  const counts = await db.prepare(`SELECT status,COUNT(*) total FROM tiendanube_status_push GROUP BY status`).all<{status: string; total: number}>();
+  const latest = await db.prepare(`SELECT order_id,platform_id,target,status,request,detail,created_at,updated_at FROM tiendanube_status_push
+ ORDER BY updated_at DESC,order_id LIMIT ?`).bind(limit).all<Record<string, string>>();
+  return {
+    mode: 'queue',
+    counts: Object.fromEntries(counts.results.map(item => [item.status, item.total])),
+    latest: latest.results.map(item => ({...item, request: item.request ? JSON.parse(item.request) : null})),
+  };
+}
