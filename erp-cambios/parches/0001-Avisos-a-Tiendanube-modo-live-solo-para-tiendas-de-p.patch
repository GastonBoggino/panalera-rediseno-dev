diff --git a/tests/tiendanube-status-push.test.mjs b/tests/tiendanube-status-push.test.mjs
new file mode 100644
index 0000000..99039a1
--- /dev/null
+++ b/tests/tiendanube-status-push.test.mjs
@@ -0,0 +1,176 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {DatabaseSync} from 'node:sqlite';
+import {readFileSync} from 'node:fs';
+import {ensureTiendanubeStatusPush,flushTiendanubeStatusPush,statusPushReport,liveSender} from '../app/api/tiendanube/statusPush.ts';
+
+const now=new Date('2026-10-22T12:00:00Z');
+function fixture(){
+ const sql=new DatabaseSync(':memory:');
+ sql.exec(`CREATE TABLE external_orders(order_id TEXT PRIMARY KEY,platform_id TEXT,source TEXT,mode TEXT);
+ CREATE TABLE order_workflow(order_id TEXT PRIMARY KEY,commercial_status TEXT,delivery_status TEXT,quote_sent_at TEXT DEFAULT '',updated_by TEXT DEFAULT '',updated_at TEXT);
+ CREATE TABLE order_sessions(order_id TEXT PRIMARY KEY,status TEXT);
+ CREATE TABLE deliveries(order_id TEXT PRIMARY KEY);`);
+ const prepare=(query,values=[])=>({
+  bind(...args){return prepare(query,args);},
+  execute(){const result=sql.prepare(query).run(...values);return {meta:{changes:Number(result.changes)}};},
+  async run(){return this.execute();},
+  async first(){return sql.prepare(query).get(...values)||null;},
+  async all(){return {results:sql.prepare(query).all(...values)};},
+ });
+ const db={prepare,async batch(statements){sql.exec('BEGIN');try{const r=statements.map(s=>s.execute());sql.exec('COMMIT');return r;}catch(e){sql.exec('ROLLBACK');throw e;}}};
+ const web=(id='1043',mode='Retiro en depósito',source='Tiendanube · API')=>{
+  sql.prepare('INSERT INTO external_orders VALUES(?,?,?,?)').run(id,'P9'+id,source,mode);
+  sql.prepare("INSERT INTO order_workflow(order_id,commercial_status,delivery_status,updated_at) VALUES(?,'quote_sent','pending',?)").run(id,now.toISOString());
+  return id;
+ };
+ // Como el ERP: todos los campos en una misma UPDATE.
+ const set=(id,fields)=>sql.prepare(`UPDATE order_workflow SET ${Object.keys(fields).map(k=>k+'=?').join(',')} WHERE order_id=?`).run(...Object.values(fields),id);
+ const rows=(id='1043')=>sql.prepare('SELECT target,status,request,detail FROM tiendanube_status_push WHERE order_id=? ORDER BY created_at,rowid').all(id);
+ return {sql,db,web,set,rows,env:{DB:db,TIENDANUBE_STATUS_PUSH:'simulate'}};
+}
+
+test('el envío real está encapsulado y la tienda real bloqueada',()=>{
+ const source=readFileSync(new URL('../app/api/tiendanube/statusPush.ts',import.meta.url),'utf8');
+ // El envío real existe, pero solo dentro de liveSender y con la tienda real bloqueada.
+ assert.match(source,/store === TIENDA_REAL \|\| permitidas\.includes\(TIENDA_REAL\)/);
+ assert.equal((source.match(/api\.tiendanube\.com/g)||[]).length,1,'una sola URL de la API, dentro de liveSender');
+});
+
+test('recorrido completo de un retiro: encola y simula cada etapa en orden',async()=>{
+ const f=fixture();await ensureTiendanubeStatusPush(f.db);
+ f.web();
+ assert.equal(f.rows().length,0,'importar no avisa nada');
+ f.set('1043',{quote_sent_at:now.toISOString()});
+ f.set('1043',{commercial_status:'confirmed'});
+ f.sql.prepare("INSERT INTO order_sessions VALUES('1043','in_progress')").run();
+ f.set('1043',{delivery_status:'ready_pickup'});
+ f.set('1043',{delivery_status:'delivered'});
+ f.sql.prepare("INSERT INTO deliveries VALUES('1043')").run();
+ assert.deepEqual(f.rows().map(r=>r.target),['quote_sent_note','confirmed_note','in_preparation','ready_for_pickup','delivered']);
+ const summary=await flushTiendanubeStatusPush(f.env,now);
+ assert.deepEqual(summary,{simulated:5,skipped:0,sent:0,failed:0,mode:'simulate'});
+ const byTarget=Object.fromEntries(f.rows().map(r=>[r.target,{...r,request:JSON.parse(r.request)}]));
+ assert.equal(byTarget.quote_sent_note.request.method,'PUT');
+ assert.equal(byTarget.quote_sent_note.request.path,'/orders/P91043');
+ assert.match(byTarget.quote_sent_note.request.body.owner_note,/^ERP · Cotización enviada/);
+ assert.deepEqual(byTarget.ready_for_pickup.request.body,{status:'READY_FOR_PICKUP'});
+ assert.equal(byTarget.delivered.request.then.path,'/orders/P91043/close');
+ assert.ok(f.rows().every(r=>r.status==='simulated'));
+});
+
+test('envío: empaquetado y despachado; nunca vuelve a una etapa anterior',async()=>{
+ const f=fixture();await ensureTiendanubeStatusPush(f.db);
+ f.web('2001','Envío a domicilio');
+ f.set('2001',{delivery_status:'ready_dispatch'});
+ f.set('2001',{delivery_status:'in_transit'});
+ await flushTiendanubeStatusPush(f.env,now);
+ // Una sesión de preparación tardía (p. ej. reapertura) no retrocede en Tiendanube.
+ f.sql.prepare("INSERT INTO order_sessions VALUES('2001','in_progress')").run();
+ const summary=await flushTiendanubeStatusPush(f.env,now);
+ assert.equal(summary.skipped,1);
+ const rows=Object.fromEntries(f.rows('2001').map(r=>[r.target,r]));
+ assert.equal(rows.packed.status,'simulated');
+ assert.equal(JSON.parse(rows.dispatched.request).body.status,'DISPATCHED');
+ assert.equal(rows.in_preparation.status,'skipped');
+ assert.match(rows.in_preparation.detail,/no acepta volver/);
+});
+
+test('cancelación: motivo según el caso y sin reenviar las que vienen de la web',async()=>{
+ const f=fixture();await ensureTiendanubeStatusPush(f.db);
+ f.web('3001');f.web('3002');
+ f.set('3001',{commercial_status:'cancelled',delivery_status:'cancelled',updated_by:'Ale Mengarelli'});
+ f.set('3002',{commercial_status:'cancelled',delivery_status:'cancelled',updated_by:'Tiendanube'});
+ await flushTiendanubeStatusPush(f.env,now);
+ const request=JSON.parse(f.rows('3001')[0].request);
+ assert.equal(request.path,'/orders/P93001/cancel');
+ assert.deepEqual(request.body,{reason:'inventory',email:true,restock:false});
+ assert.equal(f.rows('3002').length,0);
+});
+
+test('solo pedidos web y sin duplicados',async()=>{
+ const f=fixture();await ensureTiendanubeStatusPush(f.db);
+ f.web('W900','Retiro en depósito','WhatsApp');
+ f.set('W900',{commercial_status:'confirmed'});
+ assert.equal(f.rows('W900').length,0);
+ f.web('4001');
+ f.set('4001',{delivery_status:'ready_pickup'});f.set('4001',{delivery_status:'pending'});f.set('4001',{delivery_status:'ready_pickup'});
+ assert.equal(f.rows('4001').length,1);
+});
+
+test('apagado por defecto: sin modo simulación no procesa la cola',async()=>{
+ const f=fixture();await ensureTiendanubeStatusPush(f.db);
+ f.web();f.set('1043',{commercial_status:'confirmed'});
+ assert.deepEqual(await flushTiendanubeStatusPush({DB:f.db},now),{simulated:0,skipped:0,sent:0,failed:0,mode:'off'});
+ assert.deepEqual(await flushTiendanubeStatusPush({DB:f.db,TIENDANUBE_STATUS_PUSH:'live'},now),{simulated:0,skipped:0,sent:0,failed:0,mode:'live-bloqueado'});
+ assert.equal(f.rows()[0].status,'pending');
+ const report=await statusPushReport(f.db);
+ assert.equal(report.mode,'queue');
+ assert.deepEqual(report.counts,{pending:1});
+});
+
+// ---- Envío real (live) con una Tiendanube simulada ----
+const liveEnv=(f,extra={})=>({DB:f.db,TIENDANUBE_STATUS_PUSH:'live',TIENDANUBE_STORE_ID:'8415696',TIENDANUBE_WRITE_STORES:'8415696',TIENDANUBE_ACCESS_TOKEN:'t',...extra});
+function falsaApi({foStatus='UNPACKED',falla=null}={}){
+ const llamadas=[];let nota='Nota del local';let estado=foStatus;
+ const fetchImpl=async(url,init={})=>{
+  const method=init.method||'GET',path=url.replace(/^https:\/\/api\.tiendanube\.com\/v1\/\d+/,''),body=init.body?JSON.parse(init.body):undefined;
+  llamadas.push({method,path,body});
+  if(falla&&falla(method,path))return new Response(JSON.stringify({error:'x'}),{status:falla(method,path)});
+  const ok=(d)=>new Response(JSON.stringify(d),{status:200});
+  if(method==='GET'&&path.includes('fields=owner_note'))return ok({owner_note:nota});
+  if(method==='PUT')return (nota=body.owner_note,ok({}));
+  if(method==='GET'&&path.endsWith('/fulfillment-orders'))return ok([{id:'fo1',status:estado}]);
+  if(method==='PATCH')return (estado=body.status,ok({}));
+  return ok({});
+ };
+ return {llamadas,fetchImpl,nota:()=>nota};
+}
+
+test('live: nunca envía a la tienda real ni a tiendas fuera de la lista',()=>{
+ const f=fixture();
+ assert.throws(()=>liveSender(liveEnv(f,{TIENDANUBE_STORE_ID:'6357775',TIENDANUBE_WRITE_STORES:'6357775'})),/bloqueado/);
+ assert.throws(()=>liveSender(liveEnv(f,{TIENDANUBE_WRITE_STORES:'8415696,6357775'})),/bloqueado/);
+ assert.throws(()=>liveSender(liveEnv(f,{TIENDANUBE_STORE_ID:'8413613'})),/bloqueado/);
+ assert.doesNotThrow(()=>liveSender(liveEnv(f)));
+});
+
+test('live: retiro completo envía nota, preparación, listo y entregado + cierre',async()=>{
+ const f=fixture();await ensureTiendanubeStatusPush(f.db);const api=falsaApi();
+ f.web();
+ f.set('1043',{quote_sent_at:now.toISOString()});
+ f.sql.prepare("INSERT INTO order_sessions VALUES('1043','in_progress')").run();
+ f.set('1043',{delivery_status:'ready_pickup'});
+ f.sql.prepare("INSERT INTO deliveries VALUES('1043')").run();
+ const summary=await flushTiendanubeStatusPush(liveEnv(f),now,20,api.fetchImpl);
+ assert.equal(summary.sent,4,JSON.stringify(f.rows()));
+ assert.match(api.nota(),/^Nota del local\nERP · Cotización enviada/,'la nota se agrega sin pisar la del local');
+ const patches=api.llamadas.filter(l=>l.method==='PATCH').map(l=>l.body.status);
+ assert.deepEqual(patches,['IN_PREPARATION','READY_FOR_PICKUP','DELIVERED']);
+ assert.ok(api.llamadas.some(l=>l.method==='POST'&&l.path==='/orders/P91043/close'));
+ assert.ok(f.rows().every(r=>r.status==='sent'));
+});
+
+test('live: envío despachado se entrega con evento de seguimiento',async()=>{
+ const f=fixture();await ensureTiendanubeStatusPush(f.db);const api=falsaApi({foStatus:'DISPATCHED'});
+ f.web('2001','Envío a domicilio');
+ f.sql.prepare("INSERT INTO deliveries VALUES('2001')").run();
+ await flushTiendanubeStatusPush(liveEnv(f),now,20,api.fetchImpl);
+ assert.ok(api.llamadas.some(l=>l.method==='POST'&&l.path.endsWith('/fulfillment-orders/fo1/tracking-events')&&l.body.status==='delivered'));
+});
+
+test('live: errores de conexión se reintentan; rechazos quedan fallidos con motivo',async()=>{
+ const f=fixture();await ensureTiendanubeStatusPush(f.db);
+ f.web('5001');f.set('5001',{commercial_status:'confirmed'});
+ let api=falsaApi({falla:(m)=>m==='PUT'?503:0});
+ let s=await flushTiendanubeStatusPush(liveEnv(f),now,20,api.fetchImpl);
+ assert.equal(f.rows('5001')[0].status,'pending');assert.match(f.rows('5001')[0].detail,/Reintentando/);
+ api=falsaApi();
+ s=await flushTiendanubeStatusPush(liveEnv(f),now,20,api.fetchImpl);
+ assert.equal(s.sent,1);
+ f.web('5002');f.set('5002',{delivery_status:'ready_pickup'});
+ api=falsaApi({falla:(m)=>m==='PATCH'?422:0});
+ s=await flushTiendanubeStatusPush(liveEnv(f),now,20,api.fetchImpl);
+ assert.equal(s.failed,1);
+ assert.match(f.rows('5002')[0].detail,/No se pudo enviar: PATCH \/orders\/P95002\/fulfillment-orders\/fo1 → 422/);
+});
