+                  const label = item.status === "sent" ? "Enviado" : item.status === "failed" ? "No se pudo enviar" : item.status === "simulated" ? "Simulado" : item.status === "skipped" ? "Omitido" : "Pendiente";
+                  return <article key={`${item.order_id}-${item.target}`}><span className="auditType order" title={label} aria-label={label}>{item.status === "skipped" || item.status === "failed" ? <AlertTriangle size={15} aria-hidden="true" /> : <CircleCheck size={15} aria-hidden="true" />}</span><div><b>#{item.order_id} · {stage[item.target] || item.target} · {label}</b><p>{item.request ? `${item.request.method} ${item.request.path}` : item.detail}</p><small>{item.request ? `Cliente: ${item.request.customer}` : ""} · {formatOperationalDate(item.updated_at)}</small></div></article>;
+                })}
+                {statusPush && !statusPush.latest.length && <div className="emptyModule"><Globe2 size={26} /><b>Sin avisos todavía</b><span>Aparecen cuando un pedido web cambia de estado: cotización enviada, confirmado, preparación, listo, reparto, entrega o cancelación.</span></div>}
+              </div></section>
             </>
           )}
 
