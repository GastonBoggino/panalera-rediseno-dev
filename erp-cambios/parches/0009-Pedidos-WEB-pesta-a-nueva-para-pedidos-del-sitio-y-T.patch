@@ -0,0 +1,61 @@
+/* Pedidos WEB (pedidos del sitio y Tiendanube). */
+.webOrders { display:grid; gap:14px; color:#142c4b; }
+.webOrdersHead { display:flex; flex-wrap:wrap; align-items:flex-start; justify-content:space-between; gap:12px; }
+.webOrdersHead h1 { margin:0; font-size:24px; }
+.webOrdersHead p { margin:4px 0 0; color:#5d718b; font-size:14px; }
+.webOrdersRefresh { display:inline-flex; align-items:center; gap:8px; border:1px solid #b9cfee; background:#fff; color:#175bb3; border-radius:10px; padding:8px 14px; font-weight:700; cursor:pointer; }
+.webOrdersFilters { display:flex; flex-wrap:wrap; align-items:center; gap:8px; }
+.webOrdersFilters button { display:inline-flex; align-items:center; gap:8px; border:1px solid #dfe5ee; background:#fff; border-radius:999px; padding:7px 14px; font-weight:700; color:#263e5e; cursor:pointer; }
+.webOrdersFilters button b { background:#edf0f5; border-radius:999px; padding:1px 8px; font-size:12px; }
+.webOrdersFilters button.active { background:#175bb3; border-color:#175bb3; color:#fff; }
+.webOrdersFilters button.active b { background:rgba(255,255,255,.22); }
+.webOrdersFilters input { margin-left:auto; min-width:240px; border:1px solid #dfe5ee; border-radius:10px; padding:8px 12px; font:inherit; }
+.webOrdersEmpty { background:#fff; border:1px dashed #c9d4e4; border-radius:14px; padding:28px; text-align:center; color:#5d718b; }
+.webOrdersList { display:grid; gap:12px; }
+.webOrderCard { background:#fff; border:1px solid #dfe5ee; border-left:5px solid #c9d4e4; border-radius:14px; padding:14px 16px; display:grid; gap:10px; }
+.webOrderCard.state-revisar { border-left-color:#e0a100; }
+.webOrderCard.state-esperando { border-left-color:#6343ba; }
+.webOrderCard.state-confirmado, .webOrderCard.state-preparando { border-left-color:#1261c4; }
+.webOrderCard.state-listo, .webOrderCard.state-en_camino { border-left-color:#087448; }
+.webOrderCard.state-cancelado { border-left-color:#b32a22; opacity:.85; }
+.webOrderTop { display:flex; flex-wrap:wrap; align-items:center; gap:8px; }
+.webOrderId { font-weight:800; color:#175bb3; }
+.webOrderState { border-radius:999px; padding:2px 10px; font-size:12px; font-weight:800; background:#edf0f5; color:#526178; }
+.webOrderState.state-revisar { background:#fff3dd; color:#955b00; }
+.webOrderState.state-esperando { background:#f0eaff; color:#6343ba; }
+.webOrderState.state-confirmado, .webOrderState.state-preparando { background:#e4f0ff; color:#1261c4; }
+.webOrderState.state-listo, .webOrderState.state-en_camino { background:#e1f5e9; color:#087448; }
+.webOrderState.state-cancelado { background:#ffebe8; color:#b32a22; }
+.webOrderFlag { border-radius:999px; padding:2px 10px; font-size:12px; font-weight:800; background:#ffebe8; color:#b32a22; }
+.webOrderTop time { margin-left:auto; color:#5d718b; font-size:13px; }
+.webOrderMain { display:grid; grid-template-columns:minmax(180px,.8fr) minmax(300px,2fr); gap:10px 18px; align-items:start; }
+.webOrderCustomer { display:grid; gap:4px; }
+.webOrderCustomer b { font-size:17px; }
+.webOrderCustomer a { display:inline-flex; align-items:center; gap:6px; color:#175bb3; text-decoration:none; font-size:14px; }
+.webOrderFacts { display:flex; flex-wrap:wrap; gap:8px 22px; font-size:14px; }
+.webOrderFacts span { display:grid; gap:2px; }
+.webOrderFacts small, .webOrderNote small { font-size:11px; font-weight:800; color:#5d718b; letter-spacing:.04em; }
+.webOrderNote { grid-column:1 / -1; margin:0; background:#fffbea; border:1px solid #f2e2a6; border-radius:10px; padding:8px 10px; display:grid; gap:2px; font-size:14px; }
+.webOrderToggle { justify-self:start; display:inline-flex; flex-wrap:wrap; align-items:center; gap:8px; border:0; background:none; padding:0; color:#263e5e; font:inherit; font-weight:700; cursor:pointer; }
+.webOrderToggle[aria-expanded="true"] svg:first-child { transform:rotate(180deg); }
+.webOrderShort { display:inline-flex; align-items:center; gap:4px; color:#b32a22; background:#ffebe8; border-radius:999px; padding:2px 9px; font-size:12px; }
+.webOrderUncounted { color:#526178; background:#edf0f5; border-radius:999px; padding:2px 9px; font-size:12px; }
+.webOrderOk { display:inline-flex; align-items:center; gap:4px; color:#087448; background:#e1f5e9; border-radius:999px; padding:2px 9px; font-size:12px; }
+.webOrderLines { width:100%; border-collapse:collapse; font-size:14px; }
+.webOrderLines th { text-align:left; font-size:11px; color:#5d718b; padding:6px 8px; border-bottom:1px solid #dfe5ee; }
+.webOrderLines td { padding:7px 8px; border-bottom:1px solid #eef1f6; vertical-align:top; }
+.webOrderLines td small { display:block; color:#8592a6; font-size:11px; }
+.webOrderLines tr.short td { background:#fff6f5; }
+.webOrderLines .ok { color:#087448; font-weight:700; }
+.webOrderLines .short { color:#b32a22; font-weight:800; }
+.webOrderLines .uncounted { color:#526178; }
+.webOrderActions { display:flex; flex-wrap:wrap; gap:8px; }
+.webOrderActions button, .webOrderActions a { display:inline-flex; align-items:center; gap:6px; border:1px solid #dfe5ee; background:#fff; color:#263e5e; border-radius:10px; padding:8px 12px; font:inherit; font-size:14px; font-weight:700; text-decoration:none; cursor:pointer; }
+.webOrderActions .primary { background:#175bb3; border-color:#175bb3; color:#fff; }
+.webOrderActions .whatsapp { border-color:#1f9d55; color:#147a41; }
+.webOrderActions .danger { color:#b32a22; border-color:#f2c4bf; }
+.webOrderActions button:disabled { opacity:.5; cursor:not-allowed; }
+@media (max-width:820px) {
+  .webOrderMain { grid-template-columns:1fr; }
+  .webOrdersFilters input { margin-left:0; min-width:0; width:100%; }
+}
