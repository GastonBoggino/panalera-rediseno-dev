+import { useEffect, useMemo, useState } from "react";
+import { AlertTriangle, ChevronDown, CircleCheck, ExternalLink, Pencil, Phone, Printer, RefreshCw, X } from "lucide-react";
+import "./web-orders.css";
+
+// Pedidos que entran desde el sitio / Tiendanube, con los estados en palabras del local.
+// No reemplaza a "Pedidos": usa las mismas acciones del ERP (confirmar, editar, cotización, cancelar).
+
+export type WebOrderState = "revisar" | "esperando" | "confirmado" | "preparando" | "listo" | "en_camino" | "entregado" | "cancelado";
+
+export type WebOrderRow = {
+  id: string;
+  visibleId: string;
+  platformId?: string;
+  customer: string;
+  customerPhone?: string;
+  mode: string;
+  deliveryDetail?: string;
+  deliveryCity?: string;
+  items: { sku: string; qty: number }[];
+  date: string;
+  paymentMethod?: string;
+  paymentStatus?: string;
+  totalAmount?: number;
+  state: WebOrderState;
+  customerAskedToCancel: boolean;
+  returnToStore: boolean;
+};
+
+type StockInfo = { available: number; hasCount: boolean };
+
+const STATE_LABEL: Record<WebOrderState, string> = {
+  revisar: "Revisar stock", esperando: "Esperando al cliente", confirmado: "Confirmado", preparando: "En preparación",
+  listo: "Listo", en_camino: "En camino", entregado: "Entregado", cancelado: "Cancelado",
+};
+const FILTERS = [
+  { key: "revisar", label: "Revisar stock", states: ["revisar"] },
+  { key: "esperando", label: "Esperando al cliente", states: ["esperando"] },
+  { key: "curso", label: "En curso", states: ["confirmado", "preparando", "listo", "en_camino"] },
+  { key: "entregados", label: "Entregados", states: ["entregado"] },
+  { key: "cancelados", label: "Cancelados", states: ["cancelado"] },
+] as const;
+type FilterKey = (typeof FILTERS)[number]["key"];
+
+const money = (value: number) => `$ ${Math.round(value).toLocaleString("es-AR")}`;
+
+function ago(date: string, now: number) {
+  const time = new Date(date).getTime();
+  if (Number.isNaN(time)) return "";
+  const minutes = Math.max(0, Math.round((now - time) / 60000));
+  if (minutes < 60) return `hace ${minutes} min`;
+  const hours = Math.round(minutes / 60);
+  if (hours < 48) return `hace ${hours} h`;
+  return `hace ${Math.round(hours / 24)} días`;
+}
+
+// La nota del cliente viene dentro del detalle de entrega ("… · Nota del cliente: …").
+function splitDetail(detail = "") {
+  const [address, note] = detail.split(/\s*·?\s*Nota del cliente:\s*/i);
+  return { address: (address || "").trim(), note: (note || "").trim() };
+}
+
+function whatsappLink(order: WebOrderRow, missing: string[]) {
+  const digits = (order.customerPhone || "").replace(/\D/g, "");
+  if (digits.length < 10) return "";
+  const phone = digits.startsWith("54") ? digits : `54${digits}`;
+  const name = order.customer.split(/\s+/)[0] || "";
+  const total = order.totalAmount ? `\nTotal en efectivo: ${money(order.totalAmount)} · con transferencia: ${money(order.totalAmount * 1.05)}.` : "";
+  const text = missing.length
+    ? `Hola ${name}! Recibimos tu pedido web #${order.visibleId}. Revisamos el stock y nos faltan:\n${missing.map((m) => `• ${m}`).join("\n")}\n¿Te lo reemplazamos por otro producto o lo quitamos?`
+    : `Hola ${name}! Recibimos tu pedido web #${order.visibleId} y tenemos todo en stock.${total}\n¿Lo confirmamos?`;
+  return `https://wa.me/${phone}?text=${encodeURIComponent(text)}`;
+}
+
+export function WebOrdersBoard({ orders, productName, stockFor, storeAdminUrl, busyId, canEdit, canCancel, onConfirm, onEdit, onPrint, onCancel, onRefresh, refreshing }: {
+  orders: WebOrderRow[];
+  productName: (sku: string) => string;
+  stockFor: (sku: string) => StockInfo;
+  storeAdminUrl: string;
+  busyId?: string;
+  canEdit: boolean;
+  canCancel: boolean;
+  onConfirm: (id: string) => void;
+  onEdit: (id: string) => void;
+  onPrint: (id: string) => void;
+  onCancel: (id: string) => void;
+  onRefresh: () => void;
+  refreshing: boolean;
+}) {
+  const [filter, setFilter] = useState<FilterKey>("revisar");
+  const [open, setOpen] = useState<string>("");
+  const [query, setQuery] = useState("");
+  // "hace X min" se actualiza cada minuto.
+  const [now, setNow] = useState(() => Date.now());
+  useEffect(() => { const timer = window.setInterval(() => setNow(Date.now()), 60000); return () => window.clearInterval(timer); }, []);
+  const counts = useMemo(() => Object.fromEntries(FILTERS.map((f) => [f.key, orders.filter((o) => (f.states as readonly string[]).includes(o.state)).length])), [orders]);
+  const visible = useMemo(() => {
+    const states = FILTERS.find((f) => f.key === filter)!.states as readonly string[];
+    const q = query.trim().toLowerCase();
+    return orders
+      .filter((o) => states.includes(o.state))
+      .filter((o) => !q || o.visibleId.toLowerCase().includes(q) || o.customer.toLowerCase().includes(q) || (o.customerPhone || "").includes(q))
+      .sort((a, b) => (filter === "revisar" ? a.date.localeCompare(b.date) : b.date.localeCompare(a.date)));
+  }, [orders, filter, query]);
+
+  return <section className="webOrders">
+    <header className="webOrdersHead">
+      <div><h1>Pedidos WEB</h1><p>Pedidos del sitio y de Tiendanube. Revisá el stock, confirmá con el cliente y pasalos al depósito.</p></div>
+      <button type="button" className="webOrdersRefresh" onClick={onRefresh} disabled={refreshing}><RefreshCw size={17} className={refreshing ? "rotatingIcon" : ""} aria-hidden="true" />Traer pedidos web</button>
+    </header>
+    <div className="webOrdersFilters" role="tablist" aria-label="Estado de los pedidos web">
+      {FILTERS.map((f) => <button key={f.key} type="button" role="tab" aria-selected={filter === f.key} className={filter === f.key ? "active" : ""} onClick={() => setFilter(f.key)}>{f.label}<b>{counts[f.key]}</b></button>)}
+      <input type="search" placeholder="Buscar número, cliente o teléfono" value={query} onChange={(e) => setQuery(e.target.value)} aria-label="Buscar pedido web" />
+    </div>
+    {!visible.length && <div className="webOrdersEmpty">{filter === "revisar" ? "No hay pedidos web para revisar." : "No hay pedidos en este estado."}</div>}
+    <div className="webOrdersList">
+      {visible.map((o) => {
+        const lines = o.items.map((item) => { const stock = stockFor(item.sku); return { ...item, name: productName(item.sku), stock, short: stock.hasCount ? Math.max(0, item.qty - Math.max(0, stock.available)) : 0 }; });
+        const missing = lines.filter((l) => l.short > 0).map((l) => `${l.short} × ${l.name}`);
+        const uncounted = lines.filter((l) => !l.stock.hasCount).length;
+        const { address, note } = splitDetail(o.deliveryDetail);
+        const commercial = o.state === "revisar" || o.state === "esperando";
+        const busy = busyId === o.id;
+        const wa = whatsappLink(o, missing);
+        const units = o.items.reduce((total, item) => total + item.qty, 0);
+        return <article key={o.id} className={`webOrderCard state-${o.state}`}>
+          <div className="webOrderTop">
+            <span className="webOrderId">#{o.visibleId} · Web</span>
+            <span className={`webOrderState state-${o.state}`}>{STATE_LABEL[o.state]}</span>
+            {o.customerAskedToCancel && <span className="webOrderFlag">El cliente pidió cancelar · revisar</span>}
+            {o.returnToStore && <span className="webOrderFlag">Cancelado · no entregar: volver al local</span>}
+            <time dateTime={o.date}>{ago(o.date, now)}</time>
+          </div>
+          <div className="webOrderMain">
+            <div className="webOrderCustomer">
+              <b>{o.customer || "Cliente web"}</b>
+              {o.customerPhone && <a href={`tel:${o.customerPhone}`}><Phone size={14} aria-hidden="true" />{o.customerPhone}</a>}
+            </div>
+            <div className="webOrderFacts">
+              <span><small>ENTREGA</small>{o.mode}{address && !/retiro/i.test(o.mode) ? ` · ${address}` : ""}{o.deliveryCity ? ` · ${o.deliveryCity}` : ""}</span>
+              <span><small>PAGO</small>{o.paymentMethod || "Sin indicar"}{o.paymentStatus === "paid" ? " · Cobrado" : ""}</span>
+              <span><small>TOTAL</small><b>{o.totalAmount ? money(o.totalAmount) : "Sin cotizar"}</b></span>
+            </div>
+            {note && <p className="webOrderNote"><small>NOTA DEL CLIENTE</small>{note}</p>}
+          </div>
+          <button type="button" className="webOrderToggle" aria-expanded={open === o.id} onClick={() => setOpen(open === o.id ? "" : o.id)}>
+            <ChevronDown size={16} aria-hidden="true" />{units} unidad{units === 1 ? "" : "es"} · {o.items.length} producto{o.items.length === 1 ? "" : "s"}
+            {missing.length > 0 && <span className="webOrderShort"><AlertTriangle size={14} aria-hidden="true" />{missing.length} con faltante</span>}
+            {!missing.length && uncounted > 0 && <span className="webOrderUncounted">{uncounted} sin conteo de stock</span>}
+            {!missing.length && !uncounted && commercial && <span className="webOrderOk"><CircleCheck size={14} aria-hidden="true" />Stock OK</span>}
+          </button>
+          {open === o.id && <table className="webOrderLines"><thead><tr><th>Cant.</th><th>Producto</th><th>Stock en el ERP</th></tr></thead><tbody>
+            {lines.map((l) => <tr key={l.sku} className={l.short ? "short" : ""}><td>{l.qty}</td><td>{l.name}<small>{l.sku}</small></td>
+              <td>{!l.stock.hasCount ? <span className="uncounted">Sin conteo</span> : l.short ? <span className="short">Faltan {l.short} (hay {Math.max(0, l.stock.available)})</span> : <span className="ok">Hay {l.stock.available}</span>}</td></tr>)}
+          </tbody></table>}
+          <div className="webOrderActions">
+            {commercial && <button type="button" className="primary" disabled={busy} onClick={() => onConfirm(o.id)} title={missing.length ? "Hay faltantes: confirmá solo si el cliente aceptó" : uncounted ? "Hay productos sin conteo de stock: verificalos antes de confirmar" : "Stock OK: confirmar y pasar al depósito"}>{busy ? <RefreshCw size={16} className="rotatingIcon" aria-hidden="true" /> : <CircleCheck size={16} aria-hidden="true" />}{missing.length ? "Confirmar igual" : uncounted ? "Confirmar" : "Stock OK → Confirmar"}</button>}
+            {wa ? <a className="whatsapp" href={wa} target="_blank" rel="noopener noreferrer" title="Abre WhatsApp con el mensaje armado (lo enviás vos)">WhatsApp al cliente</a> : <button type="button" disabled title="Sin teléfono válido">WhatsApp al cliente</button>}
+            {commercial && canEdit && o.paymentStatus !== "paid" && <button type="button" disabled={busy} onClick={() => onEdit(o.id)}><Pencil size={16} aria-hidden="true" />Editar productos</button>}
+            <button type="button" disabled={busy} onClick={() => onPrint(o.id)}><Printer size={16} aria-hidden="true" />Imprimir cotización</button>
+            {o.platformId && storeAdminUrl && <a href={`${storeAdminUrl}/admin/orders/${encodeURIComponent(o.platformId)}`} target="_blank" rel="noopener noreferrer"><ExternalLink size={16} aria-hidden="true" />Ver en Tiendanube</a>}
+            {canCancel && !["cancelado", "entregado", "en_camino"].includes(o.state) && <button type="button" className="danger" disabled={busy} onClick={() => onCancel(o.id)}><X size={16} aria-hidden="true" />Cancelar</button>}
+          </div>
+        </article>;
+      })}
+    </div>
+  </section>;
+}
