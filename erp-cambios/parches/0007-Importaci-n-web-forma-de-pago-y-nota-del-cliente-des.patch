diff --git a/app/api/tiendanube/route.ts b/app/api/tiendanube/route.ts
index 0ac1f83..9ccc4aa 100644
--- a/app/api/tiendanube/route.ts
+++ b/app/api/tiendanube/route.ts
@@ -209,6 +209,10 @@ function normalizeOrder(order: JsonRecord) {
   const shippingDetail = [order.shipping_option, order.shipping_option_code, order.shipping_pickup_type]
     .map(localized).filter(Boolean).join(" · ");
   const pickup = /retir|pickup|punto de venta/i.test(shippingDetail);
+  // Nota del pedido web (sitio propio): forma de pago elegida y nota del cliente, para verlas en el ERP.
+  const webNote = value(order.note);
+  const webPayment = webNote.match(/Pago: (Transferencia|Efectivo)/)?.[1] || "";
+  const customerNote = (webNote.match(/Nota del cliente: (.+)$/)?.[1] || "").slice(0, 200);
   const contact = normalizeWebContact(order, pickup);
   const items = products.map((product) => ({
     sku: value(product.sku || ((product.variant || {}) as JsonRecord).sku),
@@ -223,7 +227,8 @@ function normalizeOrder(order: JsonRecord) {
     contact,
     shippingLabel: shippingDetail,
     mode: pickup ? "Retiro en depósito" : "Envío con repartidor",
-    deliveryDetail: shippingDetail || (pickup ? "Retira en depósito" : "Envío con repartidor"),
+    deliveryDetail: [shippingDetail || (pickup ? "Retira en depósito" : "Envío con repartidor"), customerNote && `Nota del cliente: ${customerNote}`].filter(Boolean).join(" · "),
+    paymentMethod: webPayment,
     items,
     status: "Cotización pendiente",
     date: value(order.created_at) || new Date().toISOString(),
@@ -448,6 +453,8 @@ export async function POST(request: Request) {
          VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`
       ).bind(order.id, order.platformId, order.customer, order.customerPhone, order.mode, order.deliveryDetail, JSON.stringify(order.items), order.status, order.date, order.source, now),
         env.DB.prepare(webQuotationWorkflowSql).bind(now, order.id, order.platformId),
+        // Forma de pago que eligió el cliente en el sitio (no pisa una ya cargada en el ERP).
+        ...(order.paymentMethod ? [env.DB.prepare("UPDATE order_workflow SET payment_method=? WHERE order_id=? AND COALESCE(payment_method,'')=''").bind(order.paymentMethod, order.id)] : []),
       ]));
     }
     for (const order of contactsToImport) {
