diff --git a/tests/web-order-note.test.mjs b/tests/web-order-note.test.mjs
new file mode 100644
index 0000000..4aa050c
--- /dev/null
+++ b/tests/web-order-note.test.mjs
@@ -0,0 +1,24 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {stripTypeScriptTypes} from 'node:module';
+import {normalizeWebContact} from '../app/api/tiendanube/customerImport.ts';
+
+// Usa la normalización real de route.ts (value, localized, normalizeOrder).
+const src=readFileSync(new URL('../app/api/tiendanube/route.ts',import.meta.url),'utf8');
+const pick=(name)=>{const s=src.indexOf(`function ${name}(`);let d=0,i=src.indexOf('{',s);for(;i<src.length;i++){if(src[i]==='{')d++;else if(src[i]==='}'&&--d===0)break;}return src.slice(s,i+1);};
+const normalizeOrder=new Function('normalizeWebContact',`${stripTypeScriptTypes(['value','localized','normalizeOrder'].map(pick).join('\n'))}\nreturn normalizeOrder;`)(normalizeWebContact);
+
+test('pedido del sitio propio: forma de pago y nota del cliente llegan al ERP',()=>{
+ const o=normalizeOrder({id:1,number:116,contact_name:'Ana',contact_phone:'+543415550102',shipping_option:'Retiro en el local (Garay 1249)',shipping_pickup_type:'pickup',
+  note:'Pedido desde el sitio propio · A confirmar stock por WhatsApp · Pago: Transferencia (+5%) · Nota del cliente: si falta, otra marca',products:[{sku:'S1',quantity:1,price:'100'}]});
+ assert.equal(o.paymentMethod,'Transferencia');
+ assert.match(o.deliveryDetail,/Retiro en el local \(Garay 1249\).*Nota del cliente: si falta, otra marca$/);
+ assert.equal(o.mode,'Retiro en depósito');
+});
+
+test('pedido web sin nota: igual que antes',()=>{
+ const o=normalizeOrder({id:2,number:2,contact_phone:'+543415550103',shipping_option:'Envío',shipping_pickup_type:'ship',products:[]});
+ assert.equal(o.paymentMethod,'');
+ assert.equal(o.deliveryDetail,'Envío · ship');
+});
