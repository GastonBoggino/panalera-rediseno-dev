{# Shipping options message #}

<div class="js-subscription-shipping-message-private" style="display:none;">
	<div class="subscription-shipping-container">
		<div class="subscription-shipping-message-title-container">
			<svg class="subscription-shipping-message-icon icon-inline"><use xlink:href="#truck"/></svg>
			<span class="subscription-shipping-message-title">
				{{ 'subscriptions.shipping_message_title' | t }}
			</span>
		</div>
		<div class="subscription-shipping-message-text box">
			{{ 'subscriptions.shipping_message' | t }}
		</div>
	</div>
</div>
