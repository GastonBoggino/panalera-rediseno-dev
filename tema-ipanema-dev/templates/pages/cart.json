{
  "sections": {
    "heading": {
      "type": "page-header"
    },
    "cart_form": {
      "type": "main-cart",
      "settings": {}
    },
    "piloto_carrito": {
      "type": "custom",
      "settings": {
        "section_width": "page",
        "direction": "column"
      },
      "blocks": {
        "piloto_carrito_code": {
          "type": "code",
          "settings": {
            "code": "<!-- Piloto rediseño: barra de avance hacia la compra mínima en la página del carrito. -->\n<style>\n  .pm-min{margin:0 0 16px;padding:14px 16px;border-radius:14px;background:#F7F8FB;border:1px solid #E1E5EE;color:#1B2340;font-size:14px}\n  .pm-min-track{height:10px;margin-top:10px;border-radius:999px;background:#E1E5EE;overflow:hidden}\n  .pm-min-fill{height:100%;border-radius:999px;background:#FFC21A;transition:width .3s}\n  .pm-min.ok{background:#DDF3E9;border-color:#DDF3E9}\n  .pm-min.ok .pm-min-fill{background:#168A5E}\n  .pm-min small{display:block;margin-top:8px;color:#5B6480}\n</style>\n<script>\n(function(){\n  var MIN=50000;\n  function money(text){var n=parseFloat(String(text).replace(/[^\\d,]/g,'').replace(',','.'));return isNaN(n)?0:n}\n  function fmt(n){return '$'+Math.round(n).toLocaleString('es-AR')}\n  function render(){\n    var sub=document.querySelector('.js-cart-subtotal'),row=document.querySelector('.cart-subtotals-container')||(sub&&sub.closest('.cart-totals-row'));\n    if(!sub||!row)return;\n    var el=document.getElementById('pm-min');\n    if(!el){el=document.createElement('div');el.id='pm-min';el.className='pm-min';row.parentNode.insertBefore(el,row)}\n    var total=money(sub.textContent),left=MIN-total,pct=Math.min(100,total/MIN*100);\n    el.classList.toggle('ok',left<=0);\n    el.innerHTML=(left>0?'Te faltan <b>'+fmt(left)+'</b> para la compra mínima de '+fmt(MIN)+'.':'<b>Llegaste a la compra mínima.</b> Ya podés enviar tu pedido.')+\n      '<div class=\"pm-min-track\"><div class=\"pm-min-fill\" style=\"width:'+pct+'%\"></div></div>'+\n      '<small>El pedido queda a confirmar: te avisamos el stock por WhatsApp antes del pago.</small>';\n  }\n  function start(){\n    render();\n    var sub=document.querySelector('.js-cart-subtotal');\n    if(sub)new MutationObserver(render).observe(sub,{childList:true,characterData:true,subtree:true});\n  }\n  document.readyState==='loading'?document.addEventListener('DOMContentLoaded',start):start();\n})();\n</script>\n",
            "width": "fill"
          }
        }
      },
      "block_order": [
        "piloto_carrito_code"
      ]
    }
  },
  "order": [
    "heading",
    "cart_form",
    "piloto_carrito"
  ]
}
